rules_version = '2';
/* Seguridad REAL del ecosistema TAGO (proyecto tago-app).
   Solo los correos Google autorizados y verificados pueden leer/escribir.
   Un extraño con el link y el apiKey público NO puede acceder a nada:
   el login anónimo ya no sirve — se exige un correo de la lista blanca. */
service cloud.firestore {
  match /databases/{database}/documents {

    function esAutorizado() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'j.perozo@tago.cl',
          'c.oviedo@tago.cl',
          'a.rodriguez@tago.cl',
          'produccion.tago@gmail.com'
        ];
    }

    // Identidad/permisos por app (nombre, apps, admin) — indexado por correo.
    match /usuarios/{uid} {
      allow read, write: if esAutorizado();
    }

    // Parámetros de la Calculadora 3D (documento único).
    match /calc_config/{docId} {
      allow read, write: if esAutorizado();
    }

    // Historial de cotizaciones.
    match /calc_cotizaciones/{docId} {
      allow read, write: if esAutorizado();
    }

    // Log de cambios de configuración (auditoría): se crea, no se edita ni borra.
    match /calc_config_log/{docId} {
      allow read, create: if esAutorizado();
      allow update, delete: if false;
    }

    // Todo lo demás: cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
