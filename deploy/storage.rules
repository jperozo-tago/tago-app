rules_version = '2';
// Reglas de Firebase Storage. Hoy el proyecto NO tiene bucket: se publican con
// `firebase deploy --only storage` cuando se active Storage en la consola.
// Adjuntos del chat de Pedidos: chat/<chatId>/<archivo>.
service firebase.storage {
  match /b/{bucket}/o {
    match /chat/{chatId}/{archivo} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 50 * 1024 * 1024;
    }
  }
}
